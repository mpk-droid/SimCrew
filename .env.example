DATABASE_URL=postgresql+asyncpg://synthetic:synthetic@localhost:5432/synthetic_users
ANTHROPIC_VERTEX_PROJECT_ID=
CLOUD_ML_REGION=

NVIDIA_API_KEY=
NVIDIA_NIM_BASE_URL=https://integrate.api.nvidia.com/v1
NVIDIA_NIM_MODEL=nvidia/nemotron-3-ultra-550b-a55b
# Optional: a second model your key can access, used if the primary keeps failing
NVIDIA_NIM_FALLBACK_MODEL=
NVIDIA_NIM_ENABLE_THINKING=false

# Any OpenAI-compatible endpoint works: set NVIDIA_NIM_BASE_URL to it and put its key in NVIDIA_API_KEY.
# NVIDIA_NIM_MODEL is the default model for runs that don't name one; users can pick any other per run.

# Claude instead: set ANTHROPIC_API_KEY (or the Vertex settings above). Default model:
# ANTHROPIC_MODEL=claude-sonnet-5-5

# Seconds to wait for all personas in a run before failing it (default 1800)
# SU_AGENT_RUN_TIMEOUT=5400
# Restrict environment images on shared instances, e.g. ghcr.io/mpk-droid/ (default: any image)
# SU_ALLOWED_ENV_IMAGE_PREFIXES=
